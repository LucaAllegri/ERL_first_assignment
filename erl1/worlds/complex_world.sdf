<?xml version="1.0"?>
<!--
  All the models are referenced with model:// URIs: Gazebo looks for them in the
  folders listed in GZ_SIM_RESOURCE_PATH (each model is a folder with model.config).
  Needed folders: table_marble, brick_box_3x1x3, dumpster, Sofa, picking_shelves, pallet_standard
  (the last two can be copied from the Fuel cache:
   cp -r ~/.gz/fuel/fuel.gazebosim.org/openrobotics/models/picking_shelves/1 <models>/picking_shelves
   cp -r ~/.gz/fuel/fuel.gazebosim.org/openrobotics/models/pallet_standard/1 <models>/pallet_standard)
-->
